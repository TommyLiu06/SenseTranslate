{
  "name": "sense-translate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Context-aware translation and explanation for Chrome and Firefox",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser.mjs test",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted --warnings-as-errors",
    "package": "node scripts/package.mjs",
    "check": "npm test && npm run build && npm run lint:firefox",
    "verify:package": "node scripts/verify-package.mjs",
    "browser:install": "node scripts/browser.mjs install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "web-ext": "10.8.0"
  }
}
